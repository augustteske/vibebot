# === Веб-сервер и API (Node.js 24) ===
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
# Для локального запуска по HTTP оставьте false; за HTTPS в production ставьте true.
COOKIE_SECURE=false
# При локальной разработке через `npm run dev` используйте http://127.0.0.1:5173,
# при запуске через Docker Compose локально — http://127.0.0.1:8787.
APP_ORIGIN=http://127.0.0.1:5173
VIBEBOT_DATA_DIR=.data

# === Telegram-бот (Python 3.12 / aiogram) ===
# Токен от @BotFather (нужен для запуска polling-бота и отправки уведомлений организатору).
TELEGRAM_BOT_TOKEN=
# Адрес Node.js API для бота (локально: http://localhost:8787, в Docker Compose: http://web:8787).
VIBEE_API_BASE_URL=http://localhost:8787
# Scoped-транспорт привязки чата (включается только когда заданы все три значения):
VIBEE_BOT_TOKEN=
VIBEE_BINDING_ID=
VIBEE_CHAT_ID=
# Необязательная папка данных бота и путь к локальной модели Whisper для /transcribe:
# VIBEBOT_DATA_DIR=.data
# VIBEE_TRANSCRIPTION_MODEL_DIR=C:/absolute/path/to/local/whisper-model

# === Генерация рекомендаций (по умолчанию — локальные шаблоны без внешнего ИИ) ===
# Для Groq/OpenAI укажите LLM_API_KEY; для Ollama можно задать локальный LLM_BASE_URL.
LLM_PROVIDER=template
LLM_API_KEY=
# Например, для Docker Ollama: http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_MODEL=

# === Отдельный opt-in эксперимент анализа синтетических текстов ===
TEXT_ANALYSIS_PROVIDER=openai
TEXT_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# === Синтетический Telegram-контур (только для локальной разработки и тестов) ===
# Никогда не включайте в production на реальных чатах.
# VIBEE_TELEGRAM_SYNTHETIC=true
# VIBEE_TELEGRAM_BOOTSTRAP_CREDENTIAL=<64 lowercase hex characters>
