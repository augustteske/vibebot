# Node API
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
# Use true behind HTTPS in production; false is for local HTTP only.
COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:5173
VIBEBOT_DATA_DIR=.data

# Telegram Bot API token. Configure on the server to send organizer
# notifications, and on the bot service to run polling. Keep it secret.
TELEGRAM_BOT_TOKEN=
# API URL used by the bot; use http://web:8787 in Docker Compose.
VIBEE_API_BASE_URL=http://localhost:8787
# These three values enable the bot's server transport only when all are set.
VIBEE_BOT_TOKEN=
VIBEE_BINDING_ID=
VIBEE_CHAT_ID=
# Optional local folder for the bot's pause marker and voice model.
# VIBEBOT_DATA_DIR=.data
# VIBEE_TRANSCRIPTION_MODEL_DIR=C:/absolute/path/to/local/whisper-model

# Optional recommendation generation. Default is the local template.
# Groq/OpenAI require LLM_API_KEY; Ollama can use a local endpoint.
LLM_PROVIDER=template
LLM_API_KEY=
# Override when using a self-hosted endpoint (for Docker Ollama, e.g.
# http://host.docker.internal:11434/v1).
LLM_BASE_URL=
# Provider defaults are used when blank.
LLM_MODEL=

# Separate, opt-in text-analysis experiment. Uses only synthetic examples.
# Provider/model are server-side settings; the API key is never sent to the browser.
TEXT_ANALYSIS_PROVIDER=openai
TEXT_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Development-only synthetic Telegram API. Never enable in production.
# VIBEE_TELEGRAM_SYNTHETIC=true
# VIBEE_TELEGRAM_BOOTSTRAP_CREDENTIAL=<64 lowercase hex characters>
