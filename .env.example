HOST=127.0.0.1
PORT=8787
NODE_ENV=production
COOKIE_SECURE=true
APP_ORIGIN=https://your-domain.example
VIBEBOT_DATA_DIR=.data

# Reserved only: the current server does not read a global bot token.
# Telegram routes are disabled in the production entry point.
# BOT_TOKEN=

# Reserved only: SQLite currently uses VIBEBOT_DATA_DIR, not DATABASE_URL.
# DATABASE_URL=file:./vibee.db
